# Mesure d'audience Google Analytics 4 (facultatif). Laisser vide pour n'avoir aucune mesure.
# Renseigner l'identifiant de mesure (G-XXXXXXXXXX) AVANT le build : la valeur est intégrée au
# site à la compilation. Le suivi ne démarre qu'après acceptation du visiteur dans le bandeau.
NEXT_PUBLIC_GA_ID=G-3FPRC1YS8Z

# Configuration SMTP pour l'envoi des e-mails (formulaires de contact et de rendez-vous)
# Si ces variables ne sont pas renseignées, les messages sont simplement journalisés
# dans la console du serveur (utile en développement).
SMTP_HOST=465
SMTP_USER=contact@fn-partners.com
SMTP_PASSWORD=FfPl}feufIyGlNo!
MAIL_FROM=mail.fn-partners.com

# Base de données MySQL (stockage des demandes soumises via /soumettre-une-demande)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=dovi4833_fnPartners_db
DB_USER=dovi4833_fnPartners_user
DB_PASSWORD=O!{T@]+q?5M=5-8G

# Dossier de stockage des pièces jointes déposées avec les demandes, en dehors du dossier
# de déploiement pour survivre aux redéploiements (ex. en production : /home/<user>/fn-partners-uploads).
UPLOAD_DIR=./var/uploads
UPLOAD_MAX_FILE_SIZE_MB=10
UPLOAD_MAX_FILES=5
